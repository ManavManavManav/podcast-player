# Podcast Index (free): https://api.podcastindex.org/signup
PODCAST_INDEX_API_KEY=
PODCAST_INDEX_API_SECRET=

# Signs sessions and encrypts users' API keys. Generate with:
#   openssl rand -base64 48
# Changing it later signs everyone out and makes saved API keys unreadable.
BETTER_AUTH_SECRET=

# --- Optional ----------------------------------------------------------------

# Whisper model: tiny | base | small | medium. Bigger is more accurate but slower.
# "base" transcribes a minute of audio in ~4s on an M1 Pro.
# WHISPER_MODEL=base

# Python interpreter that has openai-whisper installed (auto-detected otherwise).
# WHISPER_PYTHON=/usr/local/bin/python3

# --- Accounts ------------------------------------------------------------------

# Set to false once everyone who should have an account has made one.
# PODBLOCK_ALLOW_SIGNUPS=true

# Other addresses people reach this server at (comma-separated), e.g. its LAN
# IP or a domain, so sign-in works from there too.
# PODBLOCK_TRUSTED_ORIGINS=http://192.168.1.20:3000,https://podblock.example.com

# Optional "Continue with GitHub/Google" buttons (OAuth app credentials).
# Callback URL: <your server>/api/auth/callback/github (or /google)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Shared AI keys -------------------------------------------------------------
# Users add their own keys in Settings. Keys set here are used by anyone who
# hasn't added one, and are billed to you.
# ZAI_API_KEY=
# ANTHROPIC_API_KEY=

# Where analysis results are cached (default: .cache/analysis).
# PODBLOCK_CACHE_DIR=

# Where the accounts database lives (default: .data).
# PODBLOCK_DATA_DIR=
