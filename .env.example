# Podcast Index (free): https://api.podcastindex.org/signup
PODCAST_INDEX_API_KEY=
PODCAST_INDEX_API_SECRET=
# Or the secret base64-encoded, for hosts that mangle special characters:
# PODCAST_INDEX_API_SECRET_BASE64=

# Signs sessions. At least 32 characters. Generate with:
#   openssl rand -base64 48
# Changing it later signs everyone out.
BETTER_AUTH_SECRET=

# The site's public address. Sign-in links and origin checks use it; without
# it they trust each request's Host header. Leave unset for local development.
# BETTER_AUTH_URL=https://podblock.example.com

# Your email. The account you create with it becomes the admin, who approves
# everyone else's accounts. Until it exists, no one else can sign up.
PODBLOCK_ADMIN_EMAIL=

# A one-time code for creating that admin account (the sign-up form asks for
# it), so nobody else can claim the email first. Generate with:
#   openssl rand -hex 12
# Not needed once the admin exists, or if the admin signs in with GitHub/Google.
PODBLOCK_SETUP_CODE=

# --- Transcription (any OpenAI-compatible speech-to-text API) -------------------
# Groq: free tier covers ~8 hours of audio a day, then $0.04/hour.
TRANSCRIBE_API_KEY=
# TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1
# TRANSCRIBE_MODEL=whisper-large-v3-turbo
# DeepInfra instead (~$0.012/hour):
# TRANSCRIBE_BASE_URL=https://api.deepinfra.com/v1/openai
# TRANSCRIBE_MODEL=openai/whisper-large-v3-turbo

# --- Ad detection (any OpenAI-compatible chat API) ------------------------------
# Xiaomi MiMo: https://platform.xiaomimimo.com
DETECT_API_KEY=
# DETECT_BASE_URL=https://api.xiaomimimo.com/v1
# Changing the model re-runs (and bills) detection for episodes listened to afterwards.
# DETECT_MODEL=mimo-v2.6-pro        # or mimo-v2.6-flash, cheaper

# --- Database --------------------------------------------------------------------
# Unset: a local SQLite file in PODBLOCK_DATA_DIR (fine on your own machine).
# On Vercel: a hosted libSQL database, e.g. Turso (libsql://<db>.turso.io).
# DATABASE_URL=
# DATABASE_AUTH_TOKEN=
# PODBLOCK_DATA_DIR=.data

# --- Optional ----------------------------------------------------------------------

# Other addresses the site is reached at (comma-separated), so sign-in and the
# app's own requests work from them.
# PODBLOCK_TRUSTED_ORIGINS=https://podblock.example.com

# Server log level: debug, info, warn, error or silent. Logs are JSON lines.
# PODBLOCK_LOG_LEVEL=info

# Optional "Continue with GitHub/Google" buttons (OAuth app credentials; both
# halves of a pair are needed). Callback URL: <your site>/api/auth/callback/github (or /google)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Use a different ffmpeg than the one bundled with the app.
# FFMPEG_PATH=

# --- Development and testing only ----------------------------------------------------

# Other hostnames `next dev` is opened from (LAN, tailnet), comma-separated,
# without scheme or port, so live reload works there.
# DEV_ALLOWED_ORIGINS=100.64.0.1

# Point the app at scripts/fake-providers.mjs (npm run fake-providers prints the full set).
# PODCAST_INDEX_BASE_URL=http://127.0.0.1:4010/podcastindex
# Host:port pairs allowed to serve audio although private. Never in production.
# PODBLOCK_UNSAFE_ALLOW_AUDIO_HOSTS=127.0.0.1:4010
