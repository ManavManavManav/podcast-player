# Podcast Index (free): https://api.podcastindex.org/signup
PODCAST_INDEX_API_KEY=
PODCAST_INDEX_API_SECRET=

# Signs sessions. Generate with:
#   openssl rand -base64 48
# Changing it later signs everyone out.
BETTER_AUTH_SECRET=

# Your email. The account you create with it becomes the admin, who approves
# everyone else's accounts. Until it exists, no one else can sign up.
PODBLOCK_ADMIN_EMAIL=

# --- Transcription (any OpenAI-compatible speech-to-text API) -------------------
# Groq: free tier covers ~8 hours of audio a day, then $0.04/hour.
TRANSCRIBE_API_KEY=
# TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1
# TRANSCRIBE_MODEL=whisper-large-v3-turbo
# DeepInfra instead (~$0.012/hour):
# TRANSCRIBE_BASE_URL=https://api.deepinfra.com/v1/openai
# TRANSCRIBE_MODEL=openai/whisper-large-v3-turbo

# --- Ad detection (any OpenAI-compatible chat API) ------------------------------
# Xiaomi MiMo: https://platform.xiaomimimo.com
DETECT_API_KEY=
# DETECT_BASE_URL=https://api.xiaomimimo.com/v1
# DETECT_MODEL=mimo-v2.6-pro        # or mimo-v2.6-flash, cheaper

# --- Database --------------------------------------------------------------------
# Unset: a local SQLite file in .data/ (fine for running on your own machine).
# On Vercel: a hosted libSQL database, e.g. Turso (libsql://<db>.turso.io).
# DATABASE_URL=
# DATABASE_AUTH_TOKEN=

# --- Optional ----------------------------------------------------------------------

# The address people use, when it's not the one the request arrives on
# (comma-separated), so sign-in works from there.
# PODBLOCK_TRUSTED_ORIGINS=https://podblock.example.com

# Optional "Continue with GitHub/Google" buttons (OAuth app credentials).
# Callback URL: <your site>/api/auth/callback/github (or /google)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Use a different ffmpeg than the one bundled with the app.
# FFMPEG_PATH=
